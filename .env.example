# Browser
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Realtime API
PORT=3001
CORS_ORIGINS=http://localhost:3000
ROOM_CLEANUP_MS=1800000
MAX_CODE_BYTES=65536
MAX_REPLAY_FRAMES=1200
MAX_SUBMISSIONS_PER_ROOM=500
EXECUTION_CONCURRENCY=2
EXECUTION_OUTPUT_LIMIT_BYTES=65536

# PostgreSQL persistence (keep memory for local test runs).
PERSISTENCE_MODE=memory
DATABASE_URL=postgresql://codegolf:change-me@localhost:5432/codegolf
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Ephemeral realtime state. `redis` is required for multiple server instances.
EPHEMERAL_STATE_MODE=memory
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=code-golf-arena
REDIS_ROOM_TTL_MS=14400000
REDIS_RECONNECT_MAX_DELAY_MS=10000

# Account sessions require PERSISTENCE_MODE=postgres. The cookie is HttpOnly,
# Secure in production, and stores only an opaque session secret.
AUTH_SESSION_COOKIE_NAME=cga_session
AUTH_SESSION_TTL_MS=604800000
# Optional first administrator email. Set only during the initial account registration.
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# Pin these to immutable image digests in production.
EXECUTOR_PYTHON_IMAGE=python:3.11-alpine
EXECUTOR_JAVASCRIPT_IMAGE=node:22-alpine
EXECUTOR_CPP_IMAGE=gcc:14.2
EXECUTOR_JAVA_IMAGE=eclipse-temurin:21-jdk-alpine

//SMTP OTP PROVIDER
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
APP_URL=http://localhost:3000

AUTH_SECRET=